<Layouts.flash_group flash={@flash} />

<div class="px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
  <div class="mx-auto max-w-2xl text-center">
    <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
      Afterlife
    </h1>
    <p class="mt-4 text-lg text-base-content/70 text-balance">
      Messages for the people you love — held until you need them, delivered automatically
      if you ever stop checking in.
    </p>

    <div class="mt-8 flex items-center justify-center gap-3">
      <.link href={~p"/users/register"} class="btn btn-primary">
        Get started
      </.link>
      <.link href={~p"/users/log-in"} class="btn btn-ghost">
        Log in
      </.link>
    </div>
  </div>

  <div class="mx-auto mt-20 max-w-3xl">
    <ol class="grid gap-8 sm:grid-cols-3">
      <li>
        <span class="badge badge-neutral badge-lg font-semibold">1</span>
        <h2 class="mt-3 font-semibold">Write your messages</h2>
        <p class="mt-1 text-sm text-base-content/70">
          Compose what you want to say, add recipients, and attach anything that
          belongs with it. Everything is encrypted at rest.
        </p>
      </li>
      <li>
        <span class="badge badge-neutral badge-lg font-semibold">2</span>
        <h2 class="mt-3 font-semibold">Check in occasionally</h2>
        <p class="mt-1 text-sm text-base-content/70">
          A click on your dashboard, a link in a reminder email, or a ping from
          your own scripts and tools — whatever's easiest.
        </p>
      </li>
      <li>
        <span class="badge badge-neutral badge-lg font-semibold">3</span>
        <h2 class="mt-3 font-semibold">If you ever stop, we deliver</h2>
        <p class="mt-1 text-sm text-base-content/70">
          After a grace period with no check-in, your messages are sent
          automatically to the people you chose.
        </p>
      </li>
    </ol>
  </div>
</div>
